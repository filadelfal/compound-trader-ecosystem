{
    "name":  "compound-user-management",
    "version":  "1.0.0",
    "private":  true,
    "scripts":  {
                    "build":  "tsc",
                    "start":  "node dist/main.js",
                    "dev":  "tsx watch src/main.ts",
                    "test":  "dotenv -e .env.test -- jest --runInBand --config jest.config.cjs",
                    "lint":  "tsc --noEmit",
                    "migrate":  "tsx scripts/migrate.ts",
                    "test:integration":  "dotenv -e .env.test -- jest --runInBand --config jest.config.cjs tests/integration"
                },
    "dependencies":  {
                         "argon2":  "^0.45.1",
                         "express":  "^4.21.2",
                         "express-rate-limit":  "^8.6.1",
                         "helmet":  "^8.3.0",
                         "jsonwebtoken":  "^9.0.3",
                         "pg":  "^8.13.1",
                         "prom-client":  "^15.1.3",
                         "redis":  "^4.7.0",
                         "winston":  "^3.17.0",
                         "zod":  "^3.24.1"
                     },
    "devDependencies":  {
                            "@types/express":  "^5.0.0",
                            "@types/jest":  "^29.5.14",
                            "@types/jsonwebtoken":  "^9.0.10",
                            "@types/node":  "^22.10.2",
                            "@types/pg":  "^8.11.10",
                            "@types/supertest":  "^6.0.3",
                            "dotenv-cli":  "^11.0.0",
                            "jest":  "^29.7.0",
                            "supertest":  "^7.2.2",
                            "ts-jest":  "^29.4.12",
                            "tsx":  "^4.19.2",
                            "typescript":  "^5.7.2"
                        }
}
