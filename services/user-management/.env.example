NODE_ENV=development
PORT=3002
SERVICE_NAME=user-management
LOG_LEVEL=info
DATABASE_URL=postgresql://compound:replace-me@localhost:5432/compound
REDIS_URL=redis://localhost:6379/0
JWT_ACCESS_SECRET=replace-with-at-least-64-random-characters-before-running-service
JWT_REFRESH_SECRET=replace-with-a-different-64-character-random-secret-value
JWT_ISSUER=compound-trader
JWT_AUDIENCE=compound-trader-platform
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
EMAIL_VERIFICATION_EXPIRES_HOURS=24
PASSWORD_RESET_EXPIRES_MINUTES=30
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_MINUTES=15
EMAIL_PROVIDER=development
EMAIL_FROM=no-reply@example.com
# Required when EMAIL_PROVIDER=http. Production endpoints must use HTTPS.
EMAIL_API_URL=https://api.email-provider.example/v1/send
EMAIL_API_KEY=replace-with-provider-api-key
EMAIL_TIMEOUT_MS=5000
EMAIL_MAX_ATTEMPTS=3
EMAIL_OUTBOX_POLL_MS=1000
EMAIL_OUTBOX_BATCH_SIZE=20
EMAIL_OUTBOX_MAX_ATTEMPTS=8
EMAIL_OUTBOX_RETRY_BASE_SECONDS=30
WEB_APP_URL=http://localhost:3000
