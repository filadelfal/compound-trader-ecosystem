# Copy these names into your staging secret manager.
# Never commit actual secret values.

POSTGRES_PASSWORD=replace-with-a-long-random-staging-password
JWT_ACCESS_SECRET=replace-with-at-least-64-random-characters-not-a-real-secret
JWT_REFRESH_SECRET=replace-with-a-different-at-least-64-character-random-secret
OPERATOR_ASSERTION_SECRET=replace-with-a-distinct-at-least-64-character-random-secret
